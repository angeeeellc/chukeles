# ============================================================
#  Chukeles — .env.example
#  Copia este fichero a .env y rellena los valores reales.
#  NUNCA subas el fichero .env al repositorio.
# ============================================================

# ── Base de datos MySQL ────────────────────────────────────
DB_NAME=chukeles
DB_ROOT_PASSWORD=root
DB_USER=chukeles_user
DB_PASSWORD=chukeles_pass
DB_PORT=3306

# ── Backend Spring Boot ────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Secreto JWT (mínimo 64 caracteres para HMAC-SHA256)
JWT_SECRETO=chukeles-secreto-super-seguro-para-jwt-minimo-64-caracteres-requeridos-hmac
JWT_EXPIRACION_MS=86400000
UPLOAD_RUTA=./uploads

# ── Frontend Vite ──────────────────────────────────────────
VITE_API_URL=http://localhost:8080
# Clave de la Google Maps JavaScript API (obligatoria)
VITE_GOOGLE_MAPS_KEY=TU_CLAVE_DE_GOOGLE_MAPS_AQUI

# ── Docker Compose ─────────────────────────────────────────
COMPOSE_PROJECT_NAME=chukeles_app
FRONTEND_PORT=5173
